# Only Firebase Web SDK configuration: no firebase-admin, no service-account JSON.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional customer contact for WhatsApp.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Required Firebase Auth providers: Microsoft (Admin) and Anonymous (enquiries).
# Admin accounts: Firestore teamUsers/<Firebase Auth UID> with active: true and role: super_admin.
