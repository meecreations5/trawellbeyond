rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  function staff(){
   return request.auth != null
    && request.auth.token.firebase.sign_in_provider == 'microsoft.com'
    && firestore.exists(/databases/(default)/documents/teamUsers/$(request.auth.uid))
    && firestore.get(/databases/(default)/documents/teamUsers/$(request.auth.uid)).data.active == true
    && firestore.get(/databases/(default)/documents/teamUsers/$(request.auth.uid)).data.role in ['super_admin','admin','publisher','editor','media'];
  }
  function publisher(){
   return staff() && firestore.get(/databases/(default)/documents/teamUsers/$(request.auth.uid)).data.role in ['super_admin','admin','publisher'];
  }
  match /cms-public/{fileName} {
   allow read: if true;
   allow create: if staff()
    && fileName.matches('[A-Za-z0-9_-]+[.](jpg|png|webp)')
    && request.resource.size < 6 * 1024 * 1024
    && request.resource.contentType.matches('image/(jpeg|png|webp)')
    && request.resource.metadata.ownerUid == request.auth.uid;
   // Assistants may only remove their own failed uploads, never shared live media.
   allow delete: if publisher() || (staff() && resource.metadata.get('ownerUid','') == request.auth.uid);
   allow update: if false;
  }
  match /{allPaths=**} {allow read,write: if false;}
 }
}
