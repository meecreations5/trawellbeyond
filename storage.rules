rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  function staff(){
   return request.auth != null
    && request.auth.token.firebase.sign_in_provider == 'microsoft.com'
    && firestore.exists(/databases/(default)/documents/teamUsers/$(request.auth.uid))
    && firestore.get(/databases/(default)/documents/teamUsers/$(request.auth.uid)).data.active == true
    && firestore.get(/databases/(default)/documents/teamUsers/$(request.auth.uid)).data.role in ['admin','super_admin'];
  }
  match /cms-public/{fileName} {
   allow read: if true;
   allow create: if staff()
    && fileName.matches('[A-Za-z0-9_-]+[.](jpg|png|webp)')
    && request.resource.size < 6 * 1024 * 1024
    && request.resource.contentType.matches('image/(jpeg|png|webp)');
   allow delete: if staff();
   allow update: if false;
  }
  match /{allPaths=**} {allow read,write: if false;}
 }
}
